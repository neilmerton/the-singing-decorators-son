---
layout: base.njk
title: Testimonials
permalink: /testimonials/
---

<div class="container container--wide">
  <h1>Testimonials</h1>
  <p>Hear what our customers say about working with The Singing Decorator's Son.</p>

  <section>
    {% for testimonial in testimonials %}
    <blockquote class="testimonial">
      <p class="testimonial__quote">“{{ testimonial.quote }}”</p>
      <cite class="testimonial__author">— {{ testimonial.name }} ({{ testimonial.location }})</cite>
      <div class="testimonial__stars">
        {% for i in range(0, testimonial.rating) %}⭐{% endfor %}
      </div>
    </blockquote>
    {% endfor %}
  </section>
</div>