---
import { testimonials } from "../data/site";
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
---

<Layout
  title="Client Testimonials"
  description="Read what our clients say about our precise painting and decorating services."
>
  <Section title="Words from our Clients">
    <div class="testimonial-grid">
      {
        testimonials.map((testimonial) => (
          <div class:list={["grid-item", { featured: testimonial.featured }]}>
            <TestimonialCard {...testimonial} />
          </div>
        ))
      }
    </div>

    <div class="cta-banner">
      <h3>Ready to start your transformation?</h3>
      <a href="/contact" class="gold-button">Request a Consultation</a>
    </div>
  </Section>
</Layout>

<style>
  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 6rem;
  }

  /* The "Editorial" Feature */
  .grid-item.featured {
    grid-column: span 2;
    & :global(.quote-text) {
      font-size: 2rem;
      max-width: 800px;
    }
  }

  .cta-banner {
    text-align: center;
    padding: 5rem 2rem;
    background: var(--color-muted);
    border-radius: 4px;

    & h3 {
      font-size: 2rem;
      margin-bottom: 2rem;
    }
  }

  .gold-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: var(--color-accent);
    color: white;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 0.9rem;
    transition: filter 0.3s;

    &:hover {
      filter: brightness(0.9);
    }
  }

  /* Mobile Grid */
  @media (max-width: 768px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
    }
    .grid-item.featured {
      grid-column: span 1;
    }
  }
</style>
