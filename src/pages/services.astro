---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/site.js";
---

<Layout
  title="Expert Services"
  description="High-end painting, decorating, and restoration services for discerning homeowners."
>
  <Section title="Our Expertise">
    <div class="services-intro">
      <p>
        Quality is not an accident; it is the result of intelligent effort and
        high standards. We specialise in transforming spaces through light,
        color, and texture.
      </p>
    </div>

    {
      services.map((service, index) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          image={service.image}
          index={index}
        />
      ))
    }
  </Section>
</Layout>

<style>
  .services-intro {
    text-align: center;
    max-width: 700px;
    margin: -2rem auto 6rem;
    font-style: italic;
    color: #888;
    & p {
      font-size: 1.2rem;
    }
  }
</style>
