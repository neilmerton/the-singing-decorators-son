---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
---

<Layout
  title="Thank You"
  description="Thank you for reaching out to Artisan Decor. We have received your request for a quotation."
>
  <Section>
    <div class="success-container">
      <div class="status-icon">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <span class="sub-label">Inquiry Received</span>
      <h1>Thank you for <br />reaching out.</h1>

      <div class="message-body">
        <p>
          Your request for a quotation has been successfully delivered. We
          understand that your home is your most significant investment, and we
          treat every inquiry with the attention it deserves.
        </p>

        <div class="next-steps">
          <h3>What happens next?</h3>
          <ul>
            <li>
              <strong>Review:</strong> We will review your project details and images.
            </li>
            <li>
              <strong>Contact:</strong> A craftsman will call or email you within
              24 hours.
            </li>
            <li>
              <strong>Consultation:</strong> We’ll arrange a site visit to provide
              a precise, fixed-price quote.
            </li>
          </ul>
        </div>

        <a href="/" class="outline-button">Return to Home</a>
      </div>
    </div>
  </Section>
</Layout>

<style>
  .success-container {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    padding: 2rem 0;

    & .status-icon {
      width: 60px;
      height: 60px;
      margin: 0 auto 2rem;
      color: var(--color-accent);
      border: 1px solid var(--color-accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;

      & svg {
        width: 100%;
        height: 100%;
      }
    }

    & .sub-label {
      color: var(--color-accent);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.8rem;
      font-weight: 700;
    }

    & h1 {
      font-size: 3.5rem;
      margin: 1rem 0 2rem;
    }

    & .message-body {
      color: var(--color-text-muted);
      font-size: 1.1rem;
      line-height: 1.8;

      & .next-steps {
        text-align: left;
        background: var(--color-muted);
        padding: 2.5rem;
        margin: 3rem 0;
        border-radius: 2px;

        & h3 {
          font-family: var(--font-body);
          font-size: 0.9rem;
          text-transform: uppercase;
          letter-spacing: 1px;
          font-weight: 700;
          margin-bottom: 1.5rem;
        }

        & ul {
          list-style: none;
          padding: 0;

          & li {
            margin-bottom: 1rem;
            font-size: 0.95rem;
            display: flex;
            gap: 1rem;

            & strong {
              color: var(--color-text);
              min-width: 80px;
            }
          }
        }
      }
    }

    & .outline-button {
      display: inline-block;
      padding: 1rem 2rem;
      border: 1px solid var(--color-text);
      color: var(--color-text);
      text-decoration: none;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 0.8rem;
      transition: all 0.3s ease;

      &:hover {
        background: var(--color-text);
        color: white;
      }
    }
  }
</style>
