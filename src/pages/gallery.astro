---
import GalleryItem from "../components/GalleryItem.astro";
import Section from "../components/Section.astro";
import { gallery } from "../data/site";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Our Portfolio"
  description="A showcase of our precision painting and decorating work across local homes and businesses."
>
  <Section title="The Portfolio">
    <p class="intro-text">
      From heritage restorations to contemporary transformations, every
      brushstroke is guided by a commitment to quality and a classic aesthetic.
    </p>

    <div class="gallery-grid">
      {gallery.map((project) => <GalleryItem item={project} />)}
    </div>
  </Section>
</Layout>

<style>
  .intro-text {
    text-align: center;
    max-width: 600px;
    margin: -1.5rem auto 4rem;
    color: var(--color-text-muted);
  }

  .gallery-grid {
    display: grid;
    /* Clean, precise 2-column grid that expands to 3 on large screens */
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  /* Precise Responsive Adjustments */
  @media (max-width: 600px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
