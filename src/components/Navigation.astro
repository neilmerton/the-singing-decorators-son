---
import { navLinks, siteData } from "../data/site";
import NavLink from "./NavLink.astro";
---

<nav class="site-nav">
  <div class="container">
    <a href="/" class="logo">{siteData.brand.name}</a>
    <ul>
      {navLinks.map((link) => <NavLink link={link} />)}
      <li><a href="/contact" class="cta">Get Quote</a></li>
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    padding: 1.5rem 0;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    z-index: 100;

    & .container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 2rem;
    }

    & .logo {
      color: var(--color-text);
      font-family: var(--font-heading);
      font-size: 1.5rem;
      text-decoration: none;
    }

    & ul {
      align-items: center;
      display: flex;
      gap: 2rem;
      list-style: none;

      & .cta {
        background-color: var(--color-text);
        border-radius: 2px; /* Sharp edges for precision */
        color: white;
        padding: 0.6rem 1.2rem;
        text-decoration: none;
        &:hover {
          background-color: var(--color-accent);
        }
      }
    }
  }
</style>
