---
import { navLinks, siteData } from "../data/site";
import NavLink from "./NavLink.astro";
---

<nav class="site-nav">
  <div class="container">
    <a href="/" class="logo">{siteData.brand.name}</a>
    <ul>
      {navLinks.map((link) => <NavLink link={link} />)}
      <li><a href="/contact" class="cta">Get Quote</a></li>
    </ul>
    <button
      class="menu-toggle-btn"
      aria-label="Toggle mobile menu"
      popovertarget="mobileMenuPopover">Menu</button
    >
    <div class="mobile-menu" id="mobileMenuPopover" popover>
      <ul>
        {navLinks.map((link) => <NavLink link={link} />)}
        <li><a href="/contact" class="cta">Get Quote</a></li>
      </ul>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    padding: 1.5rem 0;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    z-index: 100;

    & .container {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 1.5rem;

      @media (min-width: 1056px) {
        padding: 0 2rem;
      }
    }

    & .logo {
      color: var(--color-text);
      font-family: var(--font-heading);
      font-size: 1.25rem;
      text-decoration: none;

      @media (min-width: 768px) {
        font-size: 1.5rem;
      }
    }

    & ul {
      align-items: center;
      display: none;
      gap: 2rem;
      list-style: none;

      @media (min-width: 1056px) {
        display: flex;
      }
    }
    .cta {
      background-color: var(--color-text);
      color: white;
      padding: 0.6rem 1.2rem;
      text-decoration: none;
      &:hover {
        background-color: var(--color-accent);
      }
    }
  }

  .menu-toggle-btn {
    background-color: var(--color-accent);
    border: none;
    color: var(--color-bg);
    cursor: pointer;
    font-family: inherit;
    font-size: 1rem;
    padding: 0.5rem;

    @media (min-width: 1056px) {
      display: none;
    }
  }

  .mobile-menu {
    background-color: var(--color-bg);
    border: 2px solid var(--color-accent);
    margin: initial;
    position: absolute;
    position-area: bottom span-left;
    z-index: 10;

    & ul {
      align-items: stretch;
      display: flex;
      flex-direction: column;
      gap: 0;
      list-style: none;
      margin: 0;
      padding: 0;

      li {
        display: block;
        padding: 2px;
      }

      a {
        background-color: var(--color-bg);
        border-radius: 0;
        color: var(--color-text);
        display: block;
        padding: 0.75rem 1.5rem;
        text-decoration: none;
      }

      .cta {
        background-color: var(--color-accent);
        color: var(--color-bg);
        padding: 0.6rem 1.2rem;
        text-decoration: none;
      }
    }
  }
</style>
