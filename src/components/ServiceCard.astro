---
import { Image } from "astro:assets";
const { title, description, image, index } = Astro.props;
const isEven = index % 2 === 0;
---

<div class:list={["service-row", { "row-reverse": !isEven }]}>
  <div class="image-box">
    <Image src={image} alt={title} width={800} height={600} format="avif" />
  </div>
  <div class="text-box">
    <span class="service-number">0{index + 1}</span>
    <h2>{title}</h2>
    <p>{description}</p>
    <a href="/contact" class="text-link">Inquire about {title.toLowerCase()}</a>
  </div>
</div>

<style>
  .service-row {
    display: flex;
    align-items: center;
    gap: 4rem;
    margin-bottom: 8rem;

    &.row-reverse {
      flex-direction: row-reverse;
    }
  }

  .image-box {
    flex: 1;
    overflow: hidden;
    & img {
      width: 100%;
      height: 500px;
      object-fit: cover;
      filter: grayscale(0.2); /* Classic, muted look */
      transition: filter 0.5s ease;
      &:hover {
        filter: grayscale(0);
      }
    }
  }

  .text-box {
    flex: 1;
    padding: 2rem;

    & .service-number {
      font-family: var(--font-body);
      color: var(--color-accent);
      font-weight: 700;
      letter-spacing: 2px;
      display: block;
      margin-bottom: 1rem;
    }

    & h2 {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
    }

    & p {
      color: var(--color-text-muted);
      font-size: 1.1rem;
      margin-bottom: 2rem;
      max-width: 450px;
    }

    & .text-link {
      color: var(--color-text);
      text-decoration: none;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 1px;
      border-bottom: 1px solid var(--color-accent);
      padding-bottom: 4px;
      transition: opacity 0.3s;
      &:hover {
        opacity: 0.7;
      }
    }
  }

  /* Responsive Split */
  @media (max-width: 900px) {
    .service-row,
    .service-row.row-reverse {
      flex-direction: column;
      gap: 2rem;
      margin-bottom: 4rem;
    }
    .image-box img {
      height: 350px;
    }
  }
</style>
