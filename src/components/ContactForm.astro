<form
  name="contact"
  method="POST"
  data-netlify="true"
  action="/success"
  class="quote-form"
>
  <input type="hidden" name="form-name" value="contact" />

  <div class="form-group">
    <label for="name">Name</label>
    <input type="text" id="name" name="name" required placeholder="Jane Doe" />
  </div>

  <div class="form-group">
    <label for="email">Email Address</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      placeholder="jane@example.com"
    />
  </div>

  <div class="form-group">
    <label for="telephone">Telephone</label>
    <input
      type="tel"
      id="telephone"
      name="telephone"
      required
      placeholder="07777888999"
    />
  </div>

  <div class="form-group">
    <label for="message">Project Details</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      placeholder="Tell us about your project..."></textarea>
  </div>

  <button type="submit" class="btn-primary">Request Quote</button>
</form>

<style>
  /* Modern Plain CSS (2026 standards) */
  .quote-form {
    display: grid;
    gap: 1.5rem;
    max-width: 600px;
    margin: 2rem auto;
    padding: 2rem;
    background: var(--bg-card, #f9f9f9);
    border-radius: 12px;
    border: 1px solid #e2e2e2;

    /* Native CSS Nesting */
    & .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;

      & label {
        font-weight: 600;
        font-size: 0.9rem;
      }

      & input,
      & select,
      & textarea {
        padding: 0.8rem;
        border: 1.5px solid #ccc;
        border-radius: 6px;
        font-family: inherit;
        transition: border-color 0.2s ease;

        &:focus {
          outline: none;
          border-color: var(--primary-color, #007bff);
        }
      }
    }
  }

  /* Container Query for responsiveness without Media Queries */
  @container (max-width: 400px) {
    .quote-form {
      padding: 1rem;
    }
  }
</style>
