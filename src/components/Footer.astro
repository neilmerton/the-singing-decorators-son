---
import { navLinks, siteData } from "../data/site";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">{siteData.brand.name}</a>
        <p>
          {siteData.brand.tagline}
        </p>
        <p>Areas served: {siteData.brand.areas.join(", ")}.</p>
      </div>

      <div class="footer-links">
        <h3>Navigation</h3>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-contact">
        <h3>Contact</h3>
        <address>
          <p><span>T</span> {siteData.brand.phone}</p>
          <p>
            <span>E</span>
            <a href={`mailto:${siteData.brand.email}`}>{siteData.brand.email}</a
            >
          </p>
          <p>
            <span>A</span>
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(siteData.brand.address)}`}
              target="_blank"
              rel="noopener noreferrer">{siteData.brand.address}</a
            >
          </p>
        </address>
        <div class="social-icons">
          {
            siteData.brand.socials.map((social) => (
              <a href={social.url} aria-label={social.platform}>
                {social.icon}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; {siteData.brand.yearFounded} - {currentYear}
        {siteData.brand.name}. All rights reserved.
      </p>
      <p class="footer-credit">
        Site by <a
          href="https://neil.merton.dev"
          target="_blank"
          rel="noopener noreferrer">Neil Merton</a
        > &bullet; Powered by <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --footer-text-color: hsl(0, 0%, 55%);
    background: var(--color-text);
    color: var(--color-bg);
    padding: 5rem 2rem 2rem;
    margin-top: var(--section-spacing);

    & .container {
      max-width: 1200px;
      margin: 0 auto;
    }
  }

  .footer-grid {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    gap: 4rem;
    grid-template-columns: 1.5fr 0.8fr 1fr;
    padding-bottom: 4rem;

    & h3 {
      color: var(--color-accent-dark);
      font-family: var(--font-body);
      font-size: 0.8rem;
      letter-spacing: 2px;
      margin-bottom: 1.5rem;
      text-transform: uppercase;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    & .logo {
      color: var(--color-bg);
      display: block;
      font-family: var(--font-heading);
      font-size: 1.8rem;
      text-decoration: none;
    }
    & p {
      color: var(--footer-text-color);
      font-size: 0.95rem;
      line-height: 1.7;
      max-width: 300px;
    }
  }

  .footer-links ul {
    list-style: none;
    & li {
      margin-bottom: 0.8rem;
    }
    & a {
      color: var(--color-muted);
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.3s;
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  .footer-contact {
    & address {
      color: var(--footer-text-color);
      font-size: 0.9rem;
      font-style: normal;

      a {
        color: var(--color-bg);
        text-decoration: none;
        transition: text-decoration 0.3s;
        &:hover {
          text-decoration: underline;
        }
      }
      & p {
        margin-bottom: 0.5rem;
      }
      & span {
        color: var(--color-bg);
        font-weight: 700;
        margin-right: 0.5rem;
      }
    }
  }

  .footer-credit a {
    color: var(--color-bg);
    text-decoration: none;
    transition: color 0.3s;
    &:hover {
      color: var(--color-accent);
    }
  }

  .social-icons {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    & a {
      align-items: center;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--color-bg);
      display: flex;
      font-size: 0.75rem;
      font-weight: 700;
      height: 35px;
      justify-content: center;
      text-decoration: none;
      transition:
        border-color 0.3s,
        color 0.3s;
      width: 35px;
      &:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
      }
    }
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 2rem;
    color: var(--footer-text-color);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  @media (max-width: 850px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
