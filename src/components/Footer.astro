---
import { navLinks, siteData } from "../data/site";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">{siteData.brand.name}</a>
        <p>
          {siteData.brand.tagline}
        </p>
        <p>Areas served: {siteData.brand.areas.join(", ")}</p>
      </div>

      <div class="footer-links">
        <h4>Navigation</h4>
        <ul>
          {
            navLinks.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer-contact">
        <h4>Contact</h4>
        <address>
          <p><span>T:</span> {siteData.brand.phone}</p>
          <p><span>E:</span> {siteData.brand.email}</p>
          <p><span>A:</span> {siteData.brand.address}</p>
        </address>
        <div class="social-icons">
          {
            siteData.brand.socials.map((social) => (
              <a href={social.url} aria-label={social.platform}>
                {social.icon}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        &copy; {siteData.brand.yearFounded} - {currentYear}
        {siteData.brand.name}. All rights reserved.
      </p>
      <p class="footer-credit">
        Site by <a
          href="https://neil.merton.dev"
          target="_blank"
          rel="noopener noreferrer">Neil Merton</a
        > &bullet; Powered by <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-text);
    color: white;
    padding: 5rem 2rem 2rem;
    margin-top: var(--section-spacing);

    & .container {
      max-width: 1200px;
      margin: 0 auto;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 1fr;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);

    & h4 {
      font-family: var(--font-body);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      color: var(--color-accent);
      margin-bottom: 1.5rem;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    & .logo {
      font-family: var(--font-heading);
      font-size: 1.8rem;
      text-decoration: none;
      color: white;
      display: block;
      & span {
        color: var(--color-accent);
      }
    }
    & p {
      color: #999;
      font-size: 0.95rem;
      line-height: 1.7;
      max-width: 300px;
    }
  }

  .footer-links ul {
    list-style: none;
    & li {
      margin-bottom: 0.8rem;
    }
    & a {
      color: #999;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.3s;
      &:hover {
        color: white;
      }
    }
  }

  .footer-contact {
    & address {
      font-style: normal;
      color: #999;
      font-size: 0.9rem;
      & p {
        margin-bottom: 0.5rem;
      }
      & span {
        color: white;
        font-weight: 700;
        margin-right: 0.5rem;
      }
    }
  }

  .footer-credit a {
    color: #999;
    text-decoration: none;
    transition: color 0.3s;
    &:hover {
      color: var(--color-accent);
    }
  }

  .social-icons {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    & a {
      color: white;
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.2);
      width: 35px;
      height: 35px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: border-color 0.3s;
      &:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
      }
    }
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 2rem;
    color: #666;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Responsive Adjustments using 2026 Container Queries logic or standard Media Queries */
  @media (max-width: 850px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
