---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">Artisan <span>Decor</span></a>
        <p>
          Providing a refined standard of painting and decorating for discerning
          homes and commercial spaces across London and the South East.
        </p>
      </div>

      <div class="footer-links">
        <h4>Navigation</h4>
        <ul>
          <li><a href="/services">Services</a></li>
          <li><a href="/gallery">Portfolio</a></li>
          <li><a href="/testimonials">Reviews</a></li>
          <li><a href="/about">Our Story</a></li>
          <li><a href="/contact">Get a Quote</a></li>
        </ul>
      </div>

      <div class="footer-contact">
        <h4>Contact</h4>
        <address>
          <p><span>T:</span> 020 7946 0123</p>
          <p><span>E:</span> hello@artisandecor.co.uk</p>
          <p><span>A:</span> Kensington, London, W8 4BA</p>
        </address>
        <div class="social-icons">
          <a href="#" aria-label="Instagram">IG</a>
          <a href="#" aria-label="Facebook">FB</a>
          <a href="#" aria-label="Pinterest">PI</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Artisan Decor Ltd. All rights reserved.</p>
      <p class="credit">Site by YourName | Powered by Astro</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-text);
    color: white;
    padding: 5rem 2rem 2rem;
    margin-top: var(--section-spacing);

    & .container {
      max-width: 1200px;
      margin: 0 auto;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 1fr;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);

    & h4 {
      font-family: var(--font-body);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      color: var(--color-accent);
      margin-bottom: 1.5rem;
    }
  }

  .footer-brand {
    & .logo {
      font-family: var(--font-heading);
      font-size: 1.8rem;
      text-decoration: none;
      color: white;
      display: block;
      margin-bottom: 1.5rem;
      & span {
        color: var(--color-accent);
      }
    }
    & p {
      color: #999;
      font-size: 0.95rem;
      line-height: 1.7;
      max-width: 300px;
    }
  }

  .footer-links ul {
    list-style: none;
    & li {
      margin-bottom: 0.8rem;
    }
    & a {
      color: #999;
      text-decoration: none;
      font-size: 0.9rem;
      transition: color 0.3s;
      &:hover {
        color: white;
      }
    }
  }

  .footer-contact {
    & address {
      font-style: normal;
      color: #999;
      font-size: 0.9rem;
      & p {
        margin-bottom: 0.5rem;
      }
      & span {
        color: white;
        font-weight: 700;
        margin-right: 0.5rem;
      }
    }
  }

  .social-icons {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
    & a {
      color: white;
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.2);
      width: 35px;
      height: 35px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      transition: border-color 0.3s;
      &:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
      }
    }
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 2rem;
    color: #666;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  /* Responsive Adjustments using 2026 Container Queries logic or standard Media Queries */
  @media (max-width: 850px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
