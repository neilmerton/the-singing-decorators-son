---
import { siteData } from "../data/site";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
interface Props {
  description?: string;
  title: string;
}

const { description = siteData.brand.tagline, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {siteData.brand.name}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #ffffff;
    --color-text: #1a1a1a;
    --color-accent: #b08d57; /* Brushed Gold */
    --color-muted: #f4f4f4;
    --font-heading: "Playfair Display", serif; /* Classic */
    --font-body: "Inter Variable", sans-serif; /* Precise */
    --section-spacing: 5rem;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    line-height: 1.2;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  main {
    min-height: 80vh;
  }
</style>
